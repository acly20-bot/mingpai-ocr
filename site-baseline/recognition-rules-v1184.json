    {
      "id": "v1184-lifepak20e",
      "priority": 16000,
      "match": {
        "regex": "[Ll][Ii][Ff][Ee][Pp][Aa][Kk][\\s'’*°®™·]*20[eE]\\b",
        "containsAny": [
          "Physio-Control",
          "physio-control",
          "PHYSIO-CONTROL"
        ]
      },
      "set": {
        "name": "心脏除颤器",
        "model": "LIFEPAK 20e"
      },
      "extract": {
        "codeRegex": "\\bSN\\s*[:：]?\\s*(\\d{8})(?!\\d)",
        "codeFlags": "i"
      },
      "note": "兼容品牌符号误识，型号不取REF/PN，SN动态提取",
      "stop": true
    },
